# Copier vers .env si besoin (lu par config.py ; une variable déjà définie dans l'environnement l'emporte).
# Aucune clé réelle. Ne jamais committer .env.

# Données de travail (hors Git)
# BOOKOCR_DATA_DIR=data

# Import
# BOOKOCR_MAX_FILE_MB=80
# BOOKOCR_MAX_PAGES=10000
# BOOKOCR_MAX_IMAGE_PIXELS=200000000
# BOOKOCR_MAX_PDF_PAGES=800
# BOOKOCR_PDF_IMPORT_DPI=300

# OCR
# BOOKOCR_TESSERACT=tesseract
# BOOKOCR_OCR_TIMEOUT=300
# BOOKOCR_LOW_CONFIDENCE=60
# BOOKOCR_HISTORY_DEPTH=30

# Seuils de routage (confiance 0–100)
# BOOKOCR_ROUTE_RELIABLE=80
# BOOKOCR_ROUTE_DOUBTFUL=60

# Export
# BOOKOCR_SOFFICE=soffice
# BOOKOCR_SOFFICE_TIMEOUT=240

# Ollama local (aucun modèle n'est téléchargé ; sans Ollama, tout fonctionne avec OpenCV + Tesseract)
# Le code est désactivé par défaut ; ces valeurs l'activent si ce fichier est copié en .env.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=2
OLLAMA_ANALYSIS_ENABLED=true
# false : Gemma propose, l'utilisateur valide après aperçu ; true : seules les corrections confirmées par les mesures
OLLAMA_AUTO_APPLY=false
# Une requête à la fois : mesurer la mémoire avant d'augmenter
OLLAMA_MAX_PARALLEL_REQUESTS=1
# OLLAMA_ANALYSIS_MAX_SIDE=896

# Numérisation fidèle (PDF image + couche OCR invisible)
# BOOKOCR_SCAN_PDF_DPI=300
# BOOKOCR_SCAN_JPEG_QUALITY=92
# BOOKOCR_SCAN_BATCH_SIZE=10
# BOOKOCR_SCAN_MAX_ATTEMPTS=3
# Pages traitées en même temps (une par cœur, environ 0,7 Go de mémoire chacune ; toujours 1 avec Gemma)
# BOOKOCR_SCAN_WORKERS=2

# Gemini (désactivé par défaut ; ne jamais committer GEMINI_API_KEY)
GEMINI_ENABLED=false
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=60
GEMINI_MAX_CALLS=50
